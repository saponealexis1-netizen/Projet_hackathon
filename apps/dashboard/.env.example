# Copier ce fichier en .env.local (jamais commité) puis remplir les valeurs.
# Sans ces variables, l'écran tourne en MODE DÉMO (données simulées, bandeau visible).

# Supabase — lecture de la table migration_log (côté serveur uniquement)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bouton « Lancer la migration » = VRAI agent : déclenche l'action GitHub « Lancer la migration »
# (.github/workflows/migration.yml). Jeton GitHub « fine-grained » limité à ce dépôt, droit Actions : Read and write.
# Prioritaire sur ORCHESTRATOR_URL. Voir docs/demo/README.md.
GITHUB_DISPATCH_TOKEN=
# Optionnels : dépôt, fiches lancées par le bouton, ancien CRM visé
# GITHUB_REPOSITORY=saponealexis1-netizen/Projet_hackathon
# DEMO_IDS=C-0004,C-0101,C-0102,C-0103,C-0104,C-0105
# LEGACY_CRM_URL=https://projet-hackathon-uffi.vercel.app

# Orchestration de Victoria — appelée par le bouton « Lancer la migration »
# POST {ORCHESTRATOR_URL} avec {"run_id": "<uuid>"} → doit répondre {"total": <nombre de fiches>}
ORCHESTRATOR_URL=

# Nombre de fiches attendu si l'orchestration ne le renvoie pas
MIGRATION_TOTAL=20

# Lien vers les contacts HubSpot (optionnel) : https://app.hubspot.com/contacts/<portalId>/record/0-1/
HUBSPOT_CONTACT_URL=

# Agent API H Company — utilisée UNIQUEMENT côté serveur : captures d'écran de l'agent (/api/capture, D14),
# panneau « Agents en direct » (/api/live) et garde-fou « une seule migration à la fois ».
# Sans elle, la fenêtre « Voir » affiche les champs lus sans l'image, et le panneau en direct reste vide.
HAI_API_KEY=
