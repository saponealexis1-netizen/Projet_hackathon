# Copier ce fichier en .env.local (jamais commité) puis remplir les valeurs.

# Supabase : base cachée de l'ancien CRM (table legacy_contacts), lue côté serveur uniquement.
# Sans ces deux valeurs, l'application affiche les 100 contacts de lib/contacts.fallback.json.
# Jamais de NEXT_PUBLIC_ devant ces noms : la clé ne doit pas arriver dans le navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nom exact de la variable à confirmer avec la doc / la session tech H Company.
H_COMPANY_API_KEY=
